# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# Database (SQLite)
DATABASE_URL=sqlite:metaclouds.db?mode=rwc

# Database (PostgreSQL, docker-compose 使用；与 02-secret.yaml 的 database-url 同源)
# POSTGRES_PASSWORD=change-me-strong-password

# Auth
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-please-32-chars-minimum-xxxxxxxx
JWT_EXPIRES_SECONDS=86400

# Logging
LOG_LEVEL=info
