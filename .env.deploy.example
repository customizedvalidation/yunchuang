# ==============================================================================
# 部署前置条件 · 本地环境变量模板（可提交；禁止填真实值）
#
# 用法：
#   cp .env.deploy.example .env.deploy
#   # 填入真实值（.env.deploy 已被 .gitignore 的 .env.* 规则忽略）
#   bash scripts/check-deploy-prereqs.sh --env-file .env.deploy --report
#   bash scripts/check-deploy-prereqs.sh --env-file .env.deploy --target staging --strict
#   # 全量生成 GitHub 注入命令（仅 6 个 K8s secret 用 --gh-commands）：
#   bash scripts/generate-deploy-secrets.sh --from-env .env.deploy --all-gh-commands
#   # 注入后核验 GitHub 侧键集（只列名称，不读 secret 值）：
#   bash scripts/check-deploy-prereqs.sh --verify-gh --target all
#   # 见 docs/deployment-prerequisites.md §2.5：本地 strict → 全量注入 → verify-gh → 人工开开关
#
# CI 侧同名变量来自 GitHub Variables / Secrets，映射见 docs/deployment-prerequisites.md。
# 完整清单：bash scripts/check-deploy-prereqs.sh --list
# ==============================================================================

# ---- 总闸（GitHub Variables）-------------------------------------------------
# true 才启用部署链路；留空 = 全部部署 job skipped（不报红、也不报部署成功）
DEPLOY_ENABLED=
# 逗号分隔，默认 staging；可选 development,staging,production,k8s
# 注意：启用 production 必须同时启用 staging（审批门依赖 staging 成功）
DEPLOY_TARGETS=
# 可选：true 时把内置 PG 单点从 warning 升级为硬门禁
REQUIRE_PG_HA=

# ---- development（Variables: *_BASE_URL；Secrets: 其余）----------------------
DEV_BASE_URL=
DEV_SSH_KEY=
DEV_HOST=
DEV_USER=

# ---- staging -----------------------------------------------------------------
STAGING_BASE_URL=
STAGING_SSH_KEY=
STAGING_HOST=
STAGING_USER=

# ---- production（仅 workflow_dispatch + 审批门）-----------------------------
PROD_BASE_URL=
PROD_SSH_KEY=
PROD_HOST=
PROD_USER=

# ---- 三个 compose 环境共用；留空则用 /opt/metaclouds ------------------------
DEPLOY_DIR=

# ---- k8s（全部为 GitHub Secrets；K8S_BASE_URL 为可选 Variable）--------------
# base64 -w0 ~/.kube/config 的输出（Linux）；macOS 用 base64 < ~/.kube/config | tr -d '\n'
KUBE_CONFIG=
K8S_JWT_SECRET=
# 必须是 postgresql://user:password@host:5432/db，且密码与 K8S_POSTGRES_PASSWORD 相同
K8S_DATABASE_URL=
K8S_REDIS_PASSWORD=
K8S_DEFAULT_ADMIN_PASSWORD=
K8S_POSTGRES_PASSWORD=
K8S_PROTECTED_ENDPOINTS_TOKEN=
# 可选，仅用于 GitHub Environment URL 展示；K8s 验收走 port-forward
K8S_BASE_URL=

# 生成 K8s 凭据可用：bash scripts/generate-deploy-secrets.sh --out .env.deploy.k8s
