package services

import (
	"context"
	"fmt"
	"metaclouds-backend/config"
	"metaclouds-backend/models"

	"k8s.io/client-go/kubernetes"
	"k8s.io/client-go/tools/clientcmd"
	batchv1 "k8s.io/api/batch/v1"
	corev1 "k8s.io/api/core/v1"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/apimachinery/pkg/api/resource"
	"gorm.io/gorm"
)

// K8SService K8S服务
type K8SService struct {
	db     *gorm.DB
	config *config.Config
	clientset *kubernetes.Clientset
}

// NewK8SService 创建K8S服务实例
func NewK8SService(db *gorm.DB, config *config.Config) (*K8SService, error) {
	// 加载K8S配置
	kubeconfig := config.KubernetesConfig
	if kubeconfig == "" {
		kubeconfig = "~/.kube/config"
	}

	// 创建K8S客户端
	rules := clientcmd.NewDefaultClientConfigLoadingRules()
	rules.ExplicitPath = kubeconfig
	configOverrides := &clientcmd.ConfigOverrides{}
	kubeConfig, err := clientcmd.NewNonInteractiveDeferredLoadingClientConfig(rules, configOverrides).ClientConfig()
	if err != nil {
		return nil, fmt.Errorf("failed to load kubeconfig: %v", err)
	}

	// 创建clientset
	clientset, err := kubernetes.NewForConfig(kubeConfig)
	if err != nil {
		return nil, fmt.Errorf("failed to create clientset: %v", err)
	}

	return &K8SService{
		db:     db,
		config: config,
		clientset: clientset,
	}, nil
}

// SubmitJob 提交作业到K8S
func (s *K8SService) SubmitJob(job *models.Job) error {
	// 检查clientset是否初始化
	if s.clientset == nil {
		return fmt.Errorf("k8s clientset not initialized")
	}

	// 创建Pod模板
	podTemplate := corev1.PodTemplateSpec{
		ObjectMeta: metav1.ObjectMeta{
			Name: job.Name,
		},
		Spec: corev1.PodSpec{
			Containers: []corev1.Container{
				{
					Name:  job.Name,
					Image: "nvidia/cuda:11.7.1-base-ubuntu20.04", // 使用CUDA基础镜像
					Command: []string{"sh", "-c", "echo 'Job started' && sleep 3600"},
					Resources: corev1.ResourceRequirements{
						Requests: corev1.ResourceList{
							corev1.ResourceCPU:    resource.MustParse(fmt.Sprintf("%dm", job.CPUs*1000)),
							corev1.ResourceMemory: resource.MustParse(fmt.Sprintf("%dMi", job.Memory*1024)),
						},
						Limits: corev1.ResourceList{
							corev1.ResourceCPU:    resource.MustParse(fmt.Sprintf("%dm", job.CPUs*1000)),
							corev1.ResourceMemory: resource.MustParse(fmt.Sprintf("%dMi", job.Memory*1024)),
						},
					},
				},
			},
			RestartPolicy: corev1.RestartPolicyNever,
		},
	}

	// 如果需要GPU资源，添加GPU请求
	if job.GPUs > 0 {
		podTemplate.Spec.Containers[0].Resources.Requests[corev1.ResourceName("nvidia.com/gpu")] = resource.MustParse(fmt.Sprintf("%d", job.GPUs))
		podTemplate.Spec.Containers[0].Resources.Limits[corev1.ResourceName("nvidia.com/gpu")] = resource.MustParse(fmt.Sprintf("%d", job.GPUs))
	}

	// 创建Job
	k8sJob := &batchv1.Job{
		ObjectMeta: metav1.ObjectMeta{
			Name: fmt.Sprintf("job-%d", job.ID),
		},
		Spec: batchv1.JobSpec{
			Template: podTemplate,
			BackoffLimit: func() *int32 { i := int32(3); return &i }(),
		},
	}

	// 提交Job到K8S
	_, err := s.clientset.BatchV1().Jobs("default").Create(context.Background(), k8sJob, metav1.CreateOptions{})
	if err != nil {
		return fmt.Errorf("failed to submit job to k8s: %v", err)
	}

	return nil
}

// GetJobStatus 获取K8S作业状态
func (s *K8SService) GetJobStatus(jobID uint) (string, error) {
	// 检查clientset是否初始化
	if s.clientset == nil {
		return "", fmt.Errorf("k8s clientset not initialized")
	}

	// 获取作业
	k8sJob, err := s.clientset.BatchV1().Jobs("default").Get(context.Background(), fmt.Sprintf("job-%d", jobID), metav1.GetOptions{})
	if err != nil {
		return "", fmt.Errorf("failed to get job: %v", err)
	}

	// 检查作业状态
	if k8sJob.Status.Succeeded > 0 {
		return "completed", nil
	} else if k8sJob.Status.Failed > 0 {
		return "failed", nil
	} else if k8sJob.Status.Active > 0 {
		return "running", nil
	} else {
		return "pending", nil
	}
}

// CancelJob 取消K8S作业
func (s *K8SService) CancelJob(jobID uint) error {
	// 检查clientset是否初始化
	if s.clientset == nil {
		return fmt.Errorf("k8s clientset not initialized")
	}

	// 删除作业
	err := s.clientset.BatchV1().Jobs("default").Delete(context.Background(), fmt.Sprintf("job-%d", jobID), metav1.DeleteOptions{})
	if err != nil {
		return fmt.Errorf("failed to cancel job: %v", err)
	}

	return nil
}

// GetGPUResources 获取GPU资源信息
func (s *K8SService) GetGPUResources() ([]models.Resource, error) {
	// 检查clientset是否初始化
	if s.clientset == nil {
		return nil, fmt.Errorf("k8s clientset not initialized")
	}

	// 获取所有节点
	nodes, err := s.clientset.CoreV1().Nodes().List(context.Background(), metav1.ListOptions{})
	if err != nil {
		return nil, fmt.Errorf("failed to get nodes: %v", err)
	}

	// 收集GPU资源信息
	var resources []models.Resource
	for _, node := range nodes.Items {
		// 检查节点是否有GPU
		for resourceName, capacity := range node.Status.Capacity {
			if string(resourceName) == "nvidia.com/gpu" {
				// 获取已分配的GPU资源
				allocated := node.Status.Allocatable[resourceName]
				capacityValue := capacity.Value()
				allocatedValue := allocated.Value()
				availableValue := capacityValue - allocatedValue

				// 创建资源记录
				resource := models.Resource{
					Name:        fmt.Sprintf("%s-gpu", node.Name),
					Type:        "gpu",
					Status:      "available",
					Total:       int(capacityValue),
					Used:        int(allocatedValue),
					Available:   int(availableValue),
					Utilization: float64(allocatedValue) / float64(capacityValue) * 100,
					Details:     fmt.Sprintf("Node: %s, GPU Type: NVIDIA", node.Name),
				}
				resources = append(resources, resource)
			}
		}
	}

	return resources, nil
}
