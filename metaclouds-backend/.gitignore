# ==============================================================================
# Metaclouds .gitignore 配置
# ==============================================================================
# 敏感文件和临时文件不应该提交到版本控制
# ==============================================================================

# 环境配置文件（包含敏感信息）—— 忽略所有真实环境文件，仅 .example 模板保留跟踪
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# 数据库文件
*.db
*.db-journal
*.sqlite
*.sqlite3

# 日志文件
*.log
logs/
*.log.*

# 备份文件
*.dump.gz
*.dump.gz.gpg
*.backup
backups/

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# 编译产物与构建输出
metaclouds-backend
*.exe
*.dll
*.so
*.dylib
frontend/dist/

# 测试覆盖率
*.out
coverage.out
coverage.html

# IDE 配置
.idea/
.vscode/
*.iml

# Kubernetes
*.kubeconfig
kubeconfig

# Secrets（不应该提交）
*.pem
*.key
*.crt
secrets/
