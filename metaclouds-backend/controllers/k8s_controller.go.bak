package controllers

import (
	"net/http"
	"strconv"
	"metaclouds-backend/models"
	"metaclouds-backend/services"

	"github.com/gin-gonic/gin"
)

// K8SController K8S控制器
type K8SController struct {
	k8sService *services.K8SService
}

// NewK8SController 创建K8S控制器实例
func NewK8SController(k8sService *services.K8SService) *K8SController {
	return &K8SController{
		k8sService: k8sService,
	}
}

// SubmitJob 提交作业到K8S
func (c *K8SController) SubmitJob(ctx *gin.Context) {
	// 检查K8S服务是否初始化
	if c.k8sService == nil {
		ctx.JSON(http.StatusServiceUnavailable, gin.H{"error": "K8S service not initialized"})
		return
	}

	// 从请求中获取作业ID
	jobIDStr := ctx.Query("job_id")
	jobID, err := strconv.ParseUint(jobIDStr, 10, 32)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"error": "Invalid job ID"})
		return
	}

	// 调用K8S服务提交作业
	err = c.k8sService.SubmitJob(&models.Job{ID: uint(jobID)})
	if err != nil {
		ctx.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"message": "Job submitted to K8S successfully"})
}

// GetJobStatus 获取K8S作业状态
func (c *K8SController) GetJobStatus(ctx *gin.Context) {
	// 检查K8S服务是否初始化
	if c.k8sService == nil {
		ctx.JSON(http.StatusServiceUnavailable, gin.H{"error": "K8S service not initialized"})
		return
	}

	// 从请求中获取作业ID
	jobIDStr := ctx.Query("job_id")
	jobID, err := strconv.ParseUint(jobIDStr, 10, 32)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"error": "Invalid job ID"})
		return
	}

	// 调用K8S服务获取作业状态
	status, err := c.k8sService.GetJobStatus(uint(jobID))
	if err != nil {
		ctx.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"status": status})
}

// CancelJob 取消K8S作业
func (c *K8SController) CancelJob(ctx *gin.Context) {
	// 检查K8S服务是否初始化
	if c.k8sService == nil {
		ctx.JSON(http.StatusServiceUnavailable, gin.H{"error": "K8S service not initialized"})
		return
	}

	// 从请求中获取作业ID
	jobIDStr := ctx.Query("job_id")
	jobID, err := strconv.ParseUint(jobIDStr, 10, 32)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"error": "Invalid job ID"})
		return
	}

	// 调用K8S服务取消作业
	err = c.k8sService.CancelJob(uint(jobID))
	if err != nil {
		ctx.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"message": "Job cancelled successfully"})
}

// GetGPUResources 获取GPU资源信息
func (c *K8SController) GetGPUResources(ctx *gin.Context) {
	// 检查K8S服务是否初始化
	if c.k8sService == nil {
		ctx.JSON(http.StatusServiceUnavailable, gin.H{"error": "K8S service not initialized"})
		return
	}

	// 调用K8S服务获取GPU资源信息
	resources, err := c.k8sService.GetGPUResources()
	if err != nil {
		ctx.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, resources)
}
