# ==============================================================================
# Metaclouds 生产环境配置示例
# ==============================================================================
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 修改所有 SECURE_ 和 CHANGE_ 开头的值
# 3. 确保所有必填配置已设置
# ==============================================================================

# ==============================================================================
# 必填配置（必须修改）
# ==============================================================================

# JWT 密钥（必填，至少 32 字符，建议 64+ 字符）
# 生成命令: openssl rand -base64 64
SECURE_JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG

# 默认管理员密码（必填）
SECURE_DEFAULT_ADMIN_PASSWORD=ChangeThisPassword123!

# 数据库密码（必填）
SECURE_DATABASE_PASSWORD=ChangeThisDatabasePassword123!

# ==============================================================================
# 服务器配置
# ==============================================================================

# 服务器端口
SERVER_PORT=8000

# 服务器主机
SERVER_HOST=0.0.0.0

# 环境（development / staging / production）
SERVER_ENV=production

# 允许的 CORS 源（必填，生产环境必须配置）
# 多个源用逗号分隔
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ==============================================================================
# 数据库配置
# ==============================================================================

# 数据库类型（false = PostgreSQL, true = SQLite）
# 生产环境必须设为 false
USE_SQLITE=false

# 使用内存存储（生产环境必须设为 false）
MEMORY_STORE_ENABLED=false

# PostgreSQL 连接信息
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=metaclouds
DATABASE_USER=metaclouds_user
# DATABASE_PASSWORD 在上方必填配置中

# PostgreSQL SSL 配置
# 推荐值: require, verify-full, verify-ca
DATABASE_SSL_MODE=require

# ==============================================================================
# Redis 配置
# ==============================================================================

# 是否启用 Redis（true / false）
REDIS_ENABLED=true

# Redis 连接信息
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD 可选，如需认证则设置

# ==============================================================================
# 日志配置
# ==============================================================================

# 日志级别（DEBUG / INFO / WARN / ERROR）
# 生产环境建议: WARN 或 ERROR
LOG_LEVEL=warn

# 日志格式（json / text）
LOG_FORMAT=json

# 日志输出（console / file）
LOG_OUTPUT=file

# 日志文件路径
# 确保目录存在并有写入权限
LOG_PATH=/var/log/metaclouds/backend.log

# ==============================================================================
# 限流配置
# ==============================================================================

# 是否启用限流
RATE_LIMIT_ENABLED=true

# 限流阈值（每时间段内的最大请求数）
RATE_LIMIT_REQUESTS=1000

# 限流时间段（秒）
RATE_LIMIT_DURATION_SECONDS=60

# ==============================================================================
# 熔断器配置
# ==============================================================================

# 是否启用熔断器
CIRCUIT_BREAKER_ENABLED=true

# 熔断器阈值（连续失败次数）
CIRCUIT_BREAKER_THRESHOLD=50

# 熔断器超时（秒）
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30

# ==============================================================================
# 监控配置
# ==============================================================================

# 是否启用 Prometheus 指标
PROMETHEUS_ENABLED=true

# 指标收集间隔（秒）
METRICS_COLLECTION_INTERVAL=15

# ==============================================================================
# 超时配置
# ==============================================================================

# 读取超时（秒）
READ_TIMEOUT_SECONDS=30

# 写入超时（秒）
WRITE_TIMEOUT_SECONDS=60

# 空闲超时（秒）
IDLE_TIMEOUT_SECONDS=120

# 最大请求体大小（字节）
MAX_REQUEST_BODY_SIZE=10485760

# ==============================================================================
# 备份配置（可选）
# ==============================================================================

# 备份目录
BACKUP_DIR=/var/backups/metaclouds

# 备份保留天数
RETENTION_DAYS=30

# S3 存储桶（可选，用于上传备份）
# S3_BUCKET=your-backup-bucket
# S3_PREFIX=metaclouds/backups

# 备份加密密钥（可选，GPG 加密）
# BACKUP_ENCRYPTION_KEY=your_encryption_key

# ==============================================================================
# Kubernetes 配置（可选）
# ==============================================================================

# Kubernetes API 服务器
# K8S_API_SERVER=https://kubernetes.default.svc
# K8S_API_TOKEN=/var/run/secrets/kubernetes.io/serviceaccount/token
# K8S_CA_CERT=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# K8S_NAMESPACE=metaclouds

# ==============================================================================
# 云服务商配置（可选）
# ==============================================================================

# AWS 配置
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# GCP 配置
# GCP_PROJECT=your-project
# GCP_SERVICE_ACCOUNT_KEY=/path/to/service-account.json

# Azure 配置
# AZURE_SUBSCRIPTION_ID=your_subscription
# AZURE_TENANT_ID=your_tenant
# AZURE_CLIENT_ID=your_client
# AZURE_CLIENT_SECRET=your_client_secret

# ==============================================================================
# 告警配置
# ==============================================================================

# 是否启用告警
ALERT_ENABLED=true

# 告警邮箱
ALERT_EMAIL=admin@yourcompany.com

# Slack Webhook（可选）
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ==============================================================================
# 其他配置
# ==============================================================================

# GPU 节点标签
GPU_NODE_LABEL=gpu=true

# 默认 GPU 数量
DEFAULT_GPU_COUNT=1

# 任务超时时间（秒）
JOB_TIMEOUT_SECONDS=3600

# 调度器最大并发任务数
SCHEDULER_MAX_CONCURRENT=10
