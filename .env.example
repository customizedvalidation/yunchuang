# ==============================================================================
# Metaclouds Docker Compose 环境变量
# ==============================================================================
# 模板文件：复制为 .env 后填入真实值
#
# 此文件含明文凭据，绝不可提交到版本控制。
# docker-compose.yml 中所有敏感值均声明为 ${VAR:?}，未提供时
# `docker compose up` 会直接失败并指出缺失项，而不会回退到弱口令。
#
# 变更凭据后需要同步的动作见文件末尾说明。
# ==============================================================================


# --- PostgreSQL ---
POSTGRES_USER=metaclouds
POSTGRES_DB=metaclouds
# 生成命令: openssl rand -base64 32 | tr -dc 'A-Za-z0-9-_.~' | head -c 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE

# --- Redis ---
# 生成命令: openssl rand -base64 32 | tr -dc 'A-Za-z0-9-_.~' | head -c 32
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
# 生成命令: openssl rand -base64 32 | tr -dc 'A-Za-z0-9-_.~' | head -c 32
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE

# --- 应用密钥 ---
# 生成命令: openssl rand -base64 64 | tr -d '
'
JWT_SECRET=CHANGE_ME_64_BYTES_OF_BASE64_RANDOM

# --- 引导账户口令（首次启动创建默认账户时使用） ---
# 生成命令: openssl rand -base64 32 | tr -dc 'A-Za-z0-9-_.~' | head -c 32
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE
# 生成命令: openssl rand -base64 32 | tr -dc 'A-Za-z0-9-_.~' | head -c 32
DEFAULT_USER_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE


# ==============================================================================
# 变更凭据后的同步动作
# ==============================================================================
# 1. POSTGRES_PASSWORD 变更后，已存在的 postgres_data 卷中的口令不会自动更新。
#    需进入容器执行 ALTER USER，或删除卷重新初始化（会丢数据）。
# 2. REDIS_PASSWORD 变更后需重启 redis 服务使 --requirepass 生效。
# 3. JWT_SECRET 变更会使所有已签发的令牌立即失效，用户需重新登录。
# 4. DEFAULT_ADMIN_PASSWORD 仅在数据库为空、首次创建默认账户时生效；
#    已存在的账户口令不会被覆盖。
# ==============================================================================
